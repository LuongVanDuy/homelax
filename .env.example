# Copy through scripts/setup-local.mjs to generate unique local secrets.
POSTGRES_DB=homelax
POSTGRES_USER=homelax
POSTGRES_PASSWORD=GENERATE_LOCALLY
POSTGRES_PORT=5433
DATABASE_URL=postgresql://homelax:GENERATE_LOCALLY@127.0.0.1:5433/homelax
JWT_ACCESS_SECRET=GENERATE_LOCALLY
JWT_REFRESH_SECRET=GENERATE_LOCALLY
AUTH_COOKIE_SECURE=false
NEST_PORT=5001
NEST_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_APP_URL=http://localhost:8080
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=GENERATE_LOCALLY
# Optional email delivery (password reset and email verification need SMTP).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_ADMIN_TO=admin@example.test
# Set your real HTTPS domain/contact when deploying publicly.
GEOCODING_USER_AGENT=Homelax/1.0 (+https://github.com/LuongVanDuy/homelax)
