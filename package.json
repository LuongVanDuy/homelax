{
  "name": "tiny-house-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:server:v2 && npm run build:web",
    "build:web": "npm run build:contracts && vite build",
    "build:server:v2": "node scripts/clean-server-build.mjs && npm run build:contracts && tsc -p server-v2/tsconfig.json",
    "build:contracts": "tsc -p packages/contracts/tsconfig.json",
    "typecheck:web": "tsc --noEmit",
    "typecheck:server:v2": "npm run build:contracts && tsc -p server-v2/tsconfig.json --noEmit",
    "typecheck:contracts": "tsc -p packages/contracts/tsconfig.json --noEmit",
    "preview": "vite preview",
    "server:v2": "npm run build:server:v2 && node dist-server-v2/main.js",
    "setup": "node scripts/setup-local.mjs",
    "dev": "vite",
    "admin:create": "node scripts/create-admin.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^9.4.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@tanstack/react-query": "^5.103.2",
    "@tinyhouse/contracts": "file:packages/contracts",
    "@tinymce/tinymce-react": "^6.3.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "nodemailer": "^10.0.8",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tinymce": "^8.9.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "isomorphic-git": "^1.41.8",
    "oxlint": "^1.85.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
